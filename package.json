{
  "name": "@neuralsearchindex/sdk-node",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.6.3",
  "description": "Consolidated shared SDK for NeuralSearchIndex apps (logger, cache, embeddings, geo, http, llm, preferences, schemas, auth).",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth/server": {
      "types": "./dist/auth/server.d.ts",
      "default": "./dist/auth/server.js"
    },
    "./auth/client": {
      "types": "./dist/auth/client.d.ts",
      "default": "./dist/auth/client.js"
    },
    "./auth/db": {
      "types": "./dist/auth/db.d.ts",
      "default": "./dist/auth/db.js"
    },
    "./auth/entities": {
      "types": "./dist/auth/entities.d.ts",
      "default": "./dist/auth/entities.js"
    },
    "./auth/provider": {
      "types": "./dist/auth/provider.d.ts",
      "default": "./dist/auth/provider.js"
    },
    "./logger/hono": {
      "types": "./dist/logger/hono.d.ts",
      "default": "./dist/logger/hono.js"
    },
    "./semantic": {
      "types": "./dist/cache/semantic/index.d.ts",
      "default": "./dist/cache/semantic/index.js"
    },
    "./schemas/property-type": {
      "types": "./dist/schemas/property-type.d.ts",
      "default": "./dist/schemas/property-type.js"
    },
    "./schemas/url": {
      "types": "./dist/schemas/url.d.ts",
      "default": "./dist/schemas/url.js"
    },
    "./schemas/search-event": {
      "types": "./dist/schemas/search-event.d.ts",
      "default": "./dist/schemas/search-event.js"
    },
    "./cache/redis-cache-plugin": {
      "types": "./dist/cache/redis-cache-plugin.d.ts",
      "default": "./dist/cache/redis-cache-plugin.js"
    },
    "./cache/sqlite-cache-plugin": {
      "types": "./dist/cache/sqlite-cache-plugin.d.ts",
      "default": "./dist/cache/sqlite-cache-plugin.js"
    },
    "./cache/memory-cache-plugin": {
      "types": "./dist/cache/memory-cache-plugin.d.ts",
      "default": "./dist/cache/memory-cache-plugin.js"
    },
    "./hash": {
      "types": "./dist/cache/hash.d.ts",
      "default": "./dist/cache/hash.js"
    },
    "./http/proxy-fetch": {
      "types": "./dist/http/proxy-fetch.d.ts",
      "default": "./dist/http/proxy-fetch.js"
    },
    "./http/accept-language": {
      "types": "./dist/http/accept-language.d.ts",
      "default": "./dist/http/accept-language.js"
    },
    "./http/toWebHeaders": {
      "types": "./dist/http/toWebHeaders.d.ts",
      "default": "./dist/http/toWebHeaders.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas/index.js"
    },
    "./preferences": {
      "types": "./dist/preferences/index.d.ts",
      "default": "./dist/preferences/index.js"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "default": "./dist/logger/index.js"
    },
    "./geo": {
      "types": "./dist/geo/index.d.ts",
      "default": "./dist/geo/index.js"
    },
    "./ingest": {
      "types": "./dist/ingest/index.d.ts",
      "default": "./dist/ingest/index.js"
    },
    "./llm": {
      "types": "./dist/llm/index.d.ts",
      "default": "./dist/llm/index.js"
    },
    "./metrics": {
      "types": "./dist/metrics/index.d.ts",
      "default": "./dist/metrics/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "default": "./dist/cache/index.js"
    },
    "./embeddings": {
      "types": "./dist/embeddings/index.d.ts",
      "default": "./dist/embeddings/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc --noCheck -p tsconfig.json",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@better-auth/sso": "1.7.1",
    "@langchain/cohere": "^1.1.0",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.7",
    "@langchain/openai": "^1.5.7",
    "@langchain/textsplitters": "^1.0.1",
    "@mikro-orm/core": "^6.6.2",
    "@mikro-orm/postgresql": "^6.6.2",
    "@opensearch-project/opensearch": "^3.5.1",
    "@zilliz/milvus2-sdk-node": "^3.0.3",
    "better-auth": "1.7.1",
    "better-auth-mikro-orm": "0.5.0",
    "better-sqlite3": "12.11.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.8.2",
    "langchain": "^1.5.8",
    "pg": "^8.16.3",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "pino-pretty": "^13.0.0",
    "server-only": "^0.0.1",
    "undici": "^7.4.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "hono": "^4.12.28",
    "tsc-alias": "^1.8",
    "tsup": "^8.5.0",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "protobufjs"
    ],
    "overrides": {
      "@langchain/core": "^1.2.7",
      "@modelcontextprotocol/sdk": "1.17.5",
      "zod": "3.25.76",
      "better-auth>zod": "^4.3.6",
      "@better-auth/core>zod": "^4.3.6",
      "@better-auth/sso>zod": "^4.3.6",
      "@better-auth/i18n>zod": "^4.3.6",
      "@better-auth/expo>zod": "^4.3.6"
    }
  }
}
